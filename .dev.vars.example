# Local Worker secrets for `npm run dev`.
# Copy to .dev.vars (gitignored):   cp .dev.vars.example .dev.vars
#
# These are throwaway dev values. Production values are Worker secrets
# (`wrangler secret put …` at cutover) and are never committed anywhere.

# /admin sign-in password (local only)
ADMIN_PASSWORD=dev-admin-password

# Signs admin session cookies (any long random string)
SESSION_SECRET=dev-session-secret-change-me

# Lets the local content tools submit boards to /api/import/*
IMPORT_TOKEN=dev-import-token
