# Optional local settings (copy to `.env.local`, which is gitignored).
# Nothing here is needed to run the game: live games run on the local Worker
# (`npm run dev`), and the Worker's secrets live in `.dev.vars`.
#
# Content tools (npm run content:* — see COMMANDS.md → Content tools):
# CONTENT_AI=claude-code              # or: ollama | none
# CONTENT_AI_MODEL_PLAN=opus
# CONTENT_AI_MODEL_CHECK=sonnet
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b
# CONTENT_ACTOR=Your name             # shown in the admin's Activity
#
# The live site, for `--site prod` (npm run cf:secrets writes IMPORT_TOKEN_PROD):
# CONTENT_SITE_PROD=https://play.picture-twirl.workers.dev
# IMPORT_TOKEN_PROD=…
# Staging, for `--site staging` (npm run cf:secrets -- --previews writes IMPORT_TOKEN_STAGING):
# CONTENT_SITE_STAGING=https://staging-play.picture-twirl.workers.dev
# IMPORT_TOKEN_STAGING=…
#
# PostHog analytics (telemetry v1.1 — Phase 2):
# Leave VITE_POSTHOG_KEY blank to disable analytics entirely (safe default).
# Get the key from the PostHog project settings (project ID 669448, US Cloud).
# VITE_APP_ENV distinguishes environments: development | staging | production
# (do not rely on Vite's MODE for this — staging and production both build with
# MODE=production via Cloudflare Workers Builds).
# Build version is injected automatically from CF_PAGES_COMMIT_SHA at build time.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_APP_ENV=development
