# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloudflare: local Worker secrets + local D1/R2 state (per machine)
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler

# Content tools: per-run work folders (downloads, evidence, reports)
/content/runs

# Prompt drafts can contain secrets (e.g. the admin password) — keep local
/prompt-samples

# Editor crash/temp artifacts
*.tmp.*

# Playwright / test artifacts (regenerated each run)
/test-results
/playwright-report
/screenshots
/.playwright

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
desktop.ini
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/settings.json

# The Picture Twirl Cloudflare API token (npm run cf / cf:token). Shared via Dropbox, never committed:
# GitHub refuses pushes that contain Cloudflare tokens.
/cloudflare-token.txt

# macOS / Dropbox folder-icon files ("Icon" + carriage return) — never commit
Icon
