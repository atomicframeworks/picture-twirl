{
  "name": "picture-twirl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-setup.mjs",
    "predev": "node scripts/ensure-setup.mjs && npm run db:setup:local",
    "dev": "vite",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "preshare": "node scripts/ensure-setup.mjs && npm run db:setup:local",
    "share": "node scripts/share.js",
    "prebuild": "node scripts/ensure-setup.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:prod": "node scripts/cf.mjs d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:staging": "node scripts/cf.mjs d1 migrations apply PREVIEW_DB --remote -c wrangler.preview-migrations.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "migrate:code": "node scripts/migrate-code.mjs",
    "measure:realtime": "node scripts/measure-realtime.mjs",
    "rehearse:migration": "node scripts/rehearse-migration.mjs",
    "cf": "node scripts/cf.mjs",
    "cf:token": "node scripts/cf-token.mjs",
    "cf:secrets": "node scripts/cf-secrets.mjs",
    "content:sheet": "node tools/content/cli.mjs sheet",
    "content:discover": "node tools/content/cli.mjs discover",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "node scripts/ensure-setup.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:api && npm run test:realtime",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.mjs\"",
    "test:realtime": "node --test --test-timeout=30000 --test-concurrency=1 \"tests/realtime/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "pretest:e2e": "node scripts/ensure-setup.mjs --e2e",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "cloudflared": "^0.7.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.4",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "sortablejs": "^1.15.7"
  }
}
