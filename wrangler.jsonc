{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // Picture Twirl — ONE Worker serves the game (static assets), the admin and
    // the API. Architecture: PROPOSAL.md §3 and §8.
    //
    // LOCAL-ONLY until cutover (PROPOSAL.md §9.2): `npm run dev` simulates D1/R2
    // on this machine and needs no Cloudflare login. Do NOT `wrangler deploy`
    // from this branch before cutover. Cloudflare commands go through
    // `npm run cf -- …` (the Picture Twirl token in cloudflare-token.txt) —
    // never a machine's own wrangler login, which may be another account.
    "name": "picture-twirl",
    // The Picture Twirl Cloudflare account (`npm run cf:token` checks the token reaches it).
    "account_id": "8a0bee3d189bc0c27a9761646193595e",
    "main": "./worker/index.js",
    // Newest date the bundled workerd supports; bump when wrangler is upgraded.
    "compatibility_date": "2026-10-01",

    "assets": {
        "binding": "ASSETS",
        // Unknown paths fall back to index.html (the game routes with #CODE).
        "not_found_handling": "single-page-application",
        // Everything else is a static file; only these paths run the Worker.
        "run_worker_first": ["/api/*", "/media/*"]
    },

    // Content database (boards, images, audit). Schema: migrations/.
    // No database_id: local dev doesn't need one, and the real database is
    // created + pinned at cutover.
    "d1_databases": [
        { "binding": "DB", "database_name": "picture-twirl", "migrations_dir": "migrations" }
    ],

    // Pictures (display/thumb/archive) + license evidence screenshots.
    "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "picture-twirl-media" }
    ],

    // Live games: one GameRoom Durable Object per game code (worker/rooms/).
    // SQLite-backed (the only kind on the Free plan), WebSocket Hibernation.
    "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
    ],

    "observability": { "enabled": true }
}
