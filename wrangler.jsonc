{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // Picture Twirl — ONE Worker serves the game (static assets), the admin and
    // the API. Architecture: PROPOSAL.md §3 and §8.
    //
    // Production: https://picture-twirl.k-m-mcginty.workers.dev (deployed 2026-10-04; workers.dev until a
    // custom domain). Pushes to `main` deploy it through Workers Builds — nobody
    // runs `wrangler deploy` by hand. `npm run dev` simulates D1/R2/Durable Objects
    // on this machine and needs no Cloudflare login. Setup/maintenance commands go
    // through `npm run cf -- …` (the Picture Twirl token in cloudflare-token.txt) —
    // never a machine's own wrangler login, which may be another account.
    "name": "picture-twirl",
    // The Picture Twirl Cloudflare account (`npm run cf:token` checks the token reaches it).
    "account_id": "8a0bee3d189bc0c27a9761646193595e",
    "main": "./worker/index.js",
    // Newest date the bundled workerd supports; bump when wrangler is upgraded.
    "compatibility_date": "2026-10-01",

    "assets": {
        "binding": "ASSETS",
        // Unknown paths fall back to index.html (the game routes with #CODE).
        "not_found_handling": "single-page-application",
        // Everything else is a static file; only these paths run the Worker.
        "run_worker_first": ["/api/*", "/media/*"]
    },

    // Content database (boards, images, audit). Schema: migrations/.
    // database_id = production (created 2026-10-04, Eastern North America).
    // preview_database_id only pins the LOCAL copy: wrangler names the local
    // database after preview_database_id ?? database_id ?? binding, so "DB"
    // keeps `npm run dev` on the same local data it had before production existed.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "picture-twirl",
            "database_id": "9e7ba8ef-a586-4b82-8c2a-8b1714efac83",
            "preview_database_id": "DB",
            "migrations_dir": "migrations"
        }
    ],

    // Pictures (display/thumb/archive) + license evidence screenshots.
    "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "picture-twirl-media" }
    ],

    // Live games: one GameRoom Durable Object per game code (worker/rooms/).
    // SQLite-backed (the only kind on the Free plan), WebSocket Hibernation.
    "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
    ],

    "observability": { "enabled": true }
}
